# Matchpoint - Variáveis de Ambiente

# Banco de Dados (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database"

# NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sua_chave_secreta_aqui"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="seu_google_client_id_aqui"
GOOGLE_CLIENT_SECRET="seu_google_client_secret_aqui"

# Admin Master (Seed Credentials)
ADMIN_EMAIL="admin@matchpoint.app"
ADMIN_INITIAL_PASSWORD="senha_segura_aqui"

# Sentry Errors Monitoring
SENTRY_DSN="sua_dsn_do_sentry_aqui"

# Rate Limiter (Upstash Redis) - Opcional para dev local com rate limiter em memória
UPSTASH_REDIS_URL="sua_url_upstash_aqui"

# Resend API (Notificações)
RESEND_API_KEY="sua_chave_resend_aqui"

# Cron Secret (Para Background Jobs seguros)
CRON_SECRET="sua_chave_secreta_cron_aqui"
